+# R377: run() returns eval's exit status in --execute mode (and printf's 0 in DRY mode).
+# EVERY caller must branch on it: `if run "..."; then <count>; else failed "..."; fi`.
+# Incrementing a counter on the line AFTER run() counts a FAILED command as done.
 run()  { # echo + (maybe) execute
   if [ "$DRY" -eq 1 ]; then printf '   %s[dry]%s %s\n' "$c_dim" "$c_rst" "$*";
   else printf '   %s[run]%s %s\n' "$c_grn" "$c_rst" "$*"; eval "$@"; fi
 }
 want() { [ -z "$ONLY" ] || [ "$ONLY" = "$1" ]; }
 
+# failed <what>  — the command errored; do NOT count it as done.
+failed() { say "   ${c_red}[FAILED]${c_rst} $*"; FAILED=$((FAILED+1)); }
