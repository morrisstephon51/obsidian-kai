+# keystone_landed <repo> <pr> — R376: a supersession-close is only safe if the superseding
+# PR actually MERGED. Mirrors the #9 -> #8 gate codex added in R388, applied to the two
+# KEYSTONES, where the blast radius is 39 closes instead of 1. Dry-run passes through so the
+# certified dry-run tuple (23/14/1/27/4) is unchanged.
+keystone_landed() {
+  [ "$DRY" -eq 1 ] && return 0
+  [ "$(gh pr view "$2" -R "$OWNER/$1" --json state --jq .state 2>/dev/null)" = "MERGED" ]
+}
