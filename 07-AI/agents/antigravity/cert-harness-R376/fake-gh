#!/usr/bin/env bash
# Fake gh for merge-fleet.sh cascade certification. Touches NOTHING on GitHub.
# Models the real state transition: a PR that merges successfully later reports state=MERGED.
LOG="${FAKE_LOG:-/tmp/mfcert/actions.log}"; STATE="${FAKE_STATE:-/tmp/mfcert/state.db}"
sub="$1"; obj="$2"
num=""; for a in "$@"; do case "$a" in [0-9]|[0-9][0-9]|[0-9][0-9][0-9]) num="$a"; break;; esac; done
key="$num"
case "$sub $obj" in
  "pr view")
    if printf '%s\n' "$@" | grep -q 'isDraft'; then
      if grep -qx "MERGED:$key" "$STATE" 2>/dev/null; then echo "MERGED|false|MERGEABLE"
      elif [ "$num" = "${FAKE_CONFLICT_PR:-}" ]; then echo "OPEN|false|CONFLICTING"
      else echo "OPEN|false|MERGEABLE"; fi
    else
      if grep -qx "MERGED:$key" "$STATE" 2>/dev/null; then echo "MERGED"; else echo "OPEN"; fi
    fi ;;
  "issue view") echo "OPEN" ;;
  "pr merge")
    if [ "$num" = "${FAKE_MERGE_FAIL:-}" ]; then echo "GraphQL: Protected branch / required checks failing" >&2; exit 1; fi
    echo "MERGE pr=$num" >>"$LOG"; echo "MERGED:$num" >>"$STATE" ;;
  "pr close")   echo "CLOSE-PR pr=$num" >>"$LOG" ;;
  "issue close")echo "CLOSE-ISSUE issue=$num" >>"$LOG" ;;
  "pr edit")    echo "RETARGET pr=$num" >>"$LOG" ;;
esac
exit 0
